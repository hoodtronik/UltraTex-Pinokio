{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit_check.sh\"",
            "timeout": 60,
            "statusMessage": "Syntax-checking launcher scripts and app Python"
          }
        ]
      }
    ]
  }
}
